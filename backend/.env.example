# Copy to .env and adjust. Every value has a sensible local default.
DATABASE_URL=postgresql+psycopg://dealership:dealership@localhost:5434/dealership
# Signs access tokens. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Used by the test suite only.
TEST_DATABASE_URL=postgresql+psycopg://dealership:dealership@localhost:5434/dealership_test
